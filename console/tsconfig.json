{
    "extends": "$app/tsconfig",
    "include": ["src", "e2e", "*.ts", "*.js", "scripts"],
    "exclude": ["src/service-worker"],
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "allowJs": false,
        "checkJs": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "moduleResolution": "bundler",
        "types": ["node", "$app/types"]
    }
}
