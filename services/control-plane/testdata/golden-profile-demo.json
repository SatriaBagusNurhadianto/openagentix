[
  {
    "apiVersion": "api.kagent.dev/v1alpha3",
    "kind": "ModelConfig",
    "metadata": {
      "name": "gateway-profile-demo",
      "namespace": "kagent",
      "labels": {
        "app.kubernetes.io/part-of": "openagentix",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/instance": "openagentix",
        "helm.sh/chart": "openagentix-0.2.0"
      },
      "annotations": {
        "openagentix.io/agent": "profile-demo"
      }
    },
    "spec": {
      "provider": "OpenAI",
      "model": "claude-haiku",
      "apiKeySecret": "profile-demo-virtual-key",
      "apiKeySecretKey": "OPENAI_API_KEY",
      "stream": false,
      "openAI": {
        "baseUrl": "http://model-gateway.agentgateway-system.svc.cluster.local/v1"
      }
    }
  },
  {
    "apiVersion": "api.kagent.dev/v1alpha3",
    "kind": "Harness",
    "metadata": {
      "name": "profile-demo-harness",
      "namespace": "kagent",
      "labels": {
        "app.kubernetes.io/part-of": "openagentix",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/instance": "openagentix",
        "helm.sh/chart": "openagentix-0.2.0"
      }
    },
    "spec": {
      "kagent": {},
      "workload": {
        "image": "ghcr.io/kagent-dev/kagent/golang-adk@sha256:d3b1151d39c529a6f921a58a995ff699963012001d2e5075f69bf613abebc24d"
      },
      "substrate": {
        "workerPoolRef": {
          "name": "kagent-default"
        },
        "snapshotPolicy": {
          "location": "s3://ate-snapshots/kagent/"
        }
      }
    }
  },
  {
    "apiVersion": "api.kagent.dev/v1alpha3",
    "kind": "AgentTemplate",
    "metadata": {
      "name": "profile-demo-template",
      "namespace": "kagent",
      "labels": {
        "app.kubernetes.io/part-of": "openagentix",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/instance": "openagentix",
        "helm.sh/chart": "openagentix-0.2.0"
      }
    },
    "spec": {
      "description": "Narrow demo agent on the tool profile \"lookup\"",
      "modelConfig": {
        "name": "gateway-profile-demo"
      },
      "systemPrompt": "You answer questions about software vulnerabilities and the platform's own documents. Keep answers to two sentences.\nYou have only the tools that are listed for you.\n",
      "tools": [
        {
          "mcp": {
            "server": {
              "kind": "RemoteMCPServer",
              "name": "toolhive-vmcp-lookup"
            },
            "tools": [
              "execute_tool_script",
              "osv_query_vulnerability",
              "osv_get_vulnerability",
              "knowledge_kb_search"
            ]
          }
        }
      ]
    }
  },
  {
    "apiVersion": "api.kagent.dev/v1alpha3",
    "kind": "EgressPolicy",
    "metadata": {
      "name": "profile-demo-egress",
      "namespace": "kagent",
      "labels": {
        "app.kubernetes.io/part-of": "openagentix",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/instance": "openagentix",
        "helm.sh/chart": "openagentix-0.2.0"
      }
    },
    "spec": {
      "destinations": [
        {
          "origin": "https://api.osv.dev"
        }
      ]
    }
  },
  {
    "apiVersion": "api.kagent.dev/v1alpha3",
    "kind": "Agent",
    "metadata": {
      "name": "profile-demo",
      "namespace": "kagent",
      "labels": {
        "app.kubernetes.io/part-of": "openagentix",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/instance": "openagentix",
        "helm.sh/chart": "openagentix-0.2.0"
      }
    },
    "spec": {
      "template": {
        "ref": {
          "name": "profile-demo-template"
        }
      },
      "harnessRef": {
        "name": "profile-demo-harness"
      },
      "egressPolicyRefs": [
        {
          "name": "profile-demo-egress"
        }
      ]
    }
  }
]
